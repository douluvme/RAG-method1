# Copy this file to ".env" and paste your OpenAI API key below.
OPENAI_API_KEY=sk-...

# Optional settings (the defaults are shown). Change model names here when
# OpenAI releases newer models -- the app's "Check settings" button lists the
# models your key can use.
# ECONOMY_MODEL=gpt-5-mini
# BEST_MODEL=gpt-5
# OCR_MODEL=gpt-5-mini
# CONTEXT_LIMIT_TOKENS=350000

# Prices in US dollars per 1 million tokens, used only for cost estimates.
# ECONOMY_PRICE_INPUT=0.25
# ECONOMY_PRICE_CACHED=0.025
# ECONOMY_PRICE_OUTPUT=2.00
# BEST_PRICE_INPUT=1.25
# BEST_PRICE_CACHED=0.125
# BEST_PRICE_OUTPUT=10.00

# Optional password (recommended once the app is online).
# APP_PASSWORD=
